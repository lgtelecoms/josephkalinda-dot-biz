# Copy to .env — never commit real secrets

# --- Email: Resend takes priority; otherwise SMTP (see README) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

NEXTAUTH_SECRET="replace-with-long-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

EMAIL_FROM="Joseph Kalinda <onboarding@resend.dev>"
EMAIL_TO="you@example.com"
RESEND_API_KEY=""

# Optional SMTP (used when RESEND_API_KEY is not set; see README)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Optional: require secret on POST /api/contact and /api/booking (x-leads-secret or Authorization: Bearer)
LEADS_API_SECRET=""
# Optional: max JSON lead posts per client IP per 60s window (default 30; shared via Upstash when configured)
LEADS_RATE_LIMIT_PER_MINUTE="30"

# Optional: Upstash Redis for distributed rate limits on /api/contact and /api/booking
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: browser CORS for lead APIs (exact origin string, e.g. https://hooks.zapier.com is NOT enough for Zapier server-side — use for SPA integrations)
LEADS_API_CORS_ORIGIN=""

# Optional: Vercel Blob — partner logo uploads (priority over S3)
BLOB_READ_WRITE_TOKEN=""

# Optional: S3-compatible storage for partner logos (when Blob token is unset)
S3_BUCKET=""
S3_PUBLIC_BASE_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
# MinIO / custom endpoint:
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

NEXT_PUBLIC_SITE_URL="https://www.josephkalinda.biz"

# Optional social URLs for footer
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
